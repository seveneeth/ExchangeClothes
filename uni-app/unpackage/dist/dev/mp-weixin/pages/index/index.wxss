.confetti-p.data-v-57280228 { position: absolute; -webkit-animation-name: fall-data-v-57280228; animation-name: fall-data-v-57280228; -webkit-animation-timing-function: linear; animation-timing-function: linear; -webkit-animation-iteration-count: 1; animation-iteration-count: 1;
}
@-webkit-keyframes fadein-data-v-57280228 {
from { opacity: 0; -webkit-transform: translateY(-6px); transform: translateY(-6px);
}
}
@keyframes fadein-data-v-57280228 {
