}
}
@-webkit-keyframes fall-data-v-57280228 {
0% { opacity: 0; -webkit-transform: translateY(-6vh) rotate(0); transform: translateY(-6vh) rotate(0);
}
8% { opacity: 1;
}
100% { opacity: 0; -webkit-transform: translateY(106vh) rotate(360deg); transform: translateY(106vh) rotate(360deg);
}
}
@keyframes fall-data-v-57280228 {
0% { opacity: 0; -webkit-transform: translateY(-6vh) rotate(0); transform: translateY(-6vh) rotate(0);
}
8% { opacity: 1;
}
100% { opacity: 0; -webkit-transform: translateY(106vh) rotate(360deg); transform: translateY(106vh) rotate(360deg);
}
}

